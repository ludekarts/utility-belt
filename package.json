{
  "name": "@ludekarts/utility-belt",
  "version": "0.9.0",
  "description": "JavaScript Utilities Collection",
  "files": [
    "dist"
  ],
  "types": "./dist/utility-belt.d.ts",
  "type": "module",
  "main": "dist/utility-belt.umd.js",
  "module": "dist/utility-belt.es.js",
